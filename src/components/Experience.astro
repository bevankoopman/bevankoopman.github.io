---
import { experience } from '../data/site';
---
<section id="experience" class="section wrap" aria-labelledby="experience-h">
  <h2 id="experience-h">Experience</h2>
  <p class="sub">Research leadership in search and health AI, after a career in software engineering.</p>
  <ol class="timeline">
    {experience.map((e) => (
      <li>
        <span class="years">{e.years}</span>
        <div>
          <h3>{e.role}</h3>
          <p class="org">{e.org}</p>
          <p class="blurb">{e.blurb}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .timeline { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--rule); }
  li { display: grid; grid-template-columns: 7rem 1fr; gap: 1.25rem; position: relative; padding: 0 0 1.75rem 1.5rem; }
  li:last-child { padding-bottom: 0; }
  li::before {
    content: ''; position: absolute; left: -7px; top: 0.45rem; width: 12px; height: 12px; border-radius: 50%;
    background: var(--bg); border: 2px solid var(--a1);
  }
  .years { font-family: var(--font-mono); font-size: 0.8rem; color: var(--a1); padding-top: 0.15rem; }
  h3 { margin: 0; font-size: 1rem; line-height: 1.4; }
  .org { margin: 0.1rem 0 0.35rem; font-size: 0.9rem; font-weight: 500; }
  .blurb { margin: 0; color: var(--muted); font-size: 0.9rem; }
  @media (max-width: 560px) { li { grid-template-columns: 1fr; gap: 0.25rem; } }
</style>
