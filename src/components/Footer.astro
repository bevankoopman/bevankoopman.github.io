---
import { site } from '../data/site';
---
<footer id="contact">
  <div class="wrap in">
    <p><strong>{site.name}</strong> · {site.affiliation}</p>
    <p><a href={`mailto:${site.email}`}>{site.email}</a> · {site.location}</p>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--rule); margin-top: 2rem; }
  .in { padding-top: 2rem; padding-bottom: 2.5rem; text-align: center; color: var(--muted); font-size: 0.88rem; }
  p { margin: 0.25rem 0; }
  strong { color: var(--fg); }
  a { color: var(--fg); }
</style>
