---
import { projects } from '../data/site';
---
<section id="projects" class="section wrap" aria-labelledby="projects-h">
  <h2 id="projects-h">Selected Projects</h2>
  <p class="sub">A selection of my research taken from initial research through to working systems with impact.</p>
  <div class="grid">
    {projects.map((p) => (
      <article class="card">
        <p class="name">{p.name}</p>
        <h3>{p.title}</h3>
        <p class="blurb">{p.blurb}</p>
        <ul class="hl">
          {p.highlights.map((h) => <li>{h}</li>)}
        </ul>
        {p.paper && <a class="paper" href={`#pub-${p.paper}`}>Read the paper →</a>}
      </article>
    ))}
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem; }
  .card {
    display: flex; flex-direction: column;
    background: var(--card); border: 1px solid var(--rule); border-radius: var(--radius); padding: 1.5rem;
  }
  .name { font-family: var(--font-mono); font-size: 0.8rem; color: var(--a1); margin: 0 0 0.4rem; }
  h3 { margin: 0 0 0.5rem; font-size: 1.05rem; line-height: 1.35; }
  .blurb { margin: 0; color: var(--muted); font-size: 0.92rem; }
  .hl {
    margin: 1rem 0 0; padding: 1rem 0 0 1.1rem; border-top: 1px solid var(--rule);
    display: grid; gap: 0.4rem; font-size: 0.85rem; line-height: 1.45;
  }
  .hl li::marker { color: var(--a1); }
  .paper { margin-top: auto; padding-top: 1rem; font-size: 0.85rem; font-weight: 600; text-decoration: none; }
  .paper:hover { text-decoration: underline; text-decoration-color: var(--a1); }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
